/*
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  X-Frame-Options: DENY
  Content-Security-Policy: default-src 'self'; script-src 'self' https://static.cloudflareinsights.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://hdxzqbdiokjklnypfisq.supabase.co; connect-src 'self' https://hdxzqbdiokjklnypfisq.supabase.co wss://hdxzqbdiokjklnypfisq.supabase.co https://cloudflareinsights.com; worker-src 'self'; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'

# Launch A6 (21 Oct 2026): the security policy above lets the panel run only its own scripts and
# talk only to the gym server (plus Cloudflare's own visit counter, which Cloudflare adds to the
# page). The invite and check-in pages carry one small script the Worker
# writes into them (the gym's name), so they go without it (they hold no sign-in and no data).
# vite.config.ts applies the same policy to `vite preview`, so every admin-app journey runs under it.
/join
  ! Content-Security-Policy
/join.html
  ! Content-Security-Policy
/checkin
  ! Content-Security-Policy
/checkin.html
  ! Content-Security-Policy

# The page itself is always re-checked, so an open tab never keeps a page that points at
# script files a newer deploy has replaced (that showed a blank screen once).
/
  Cache-Control: no-cache
/index.html
  Cache-Control: no-cache

# Built files carry their content hash in the name: keep them for a year.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# The service worker is always re-checked, so a change to it reaches every installed panel.
/sw.js
  Cache-Control: no-cache
