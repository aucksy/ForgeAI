{
  "expo": {
    "name": "MettleUp",
    "slug": "forgeai",
    "version": "0.59.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": ["mettleup", "forgeai"],
    "userInterfaceStyle": "dark",
    "backgroundColor": "#07080C",
    "android": {
      "package": "com.mettleup.app",
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "backgroundColor": "#1B1F26",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "app.mettleup.fit", "pathPrefix": "/j/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "app.mettleup.fit", "pathPrefix": "/c/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "forgeai.aakashpahuja.in", "pathPrefix": "/j/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        },
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [{ "scheme": "https", "host": "forgeai.aakashpahuja.in", "pathPrefix": "/c/" }],
          "category": ["BROWSABLE", "DEFAULT"]
        }
      ],
      "permissions": [
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.SCHEDULE_EXACT_ALARM"
      ]
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#1B1F26",
          "android": {
            "image": "./assets/images/splash-icon.png",
            "imageWidth": 150
          }
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "enableProguardInReleaseBuilds": true,
            "enableShrinkResourcesInReleaseBuilds": true
          }
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "MettleUp uses your photos so the AI coach can estimate nutrition from meal pictures.",
          "cameraPermission": "MettleUp uses the camera so you can snap a meal for instant nutrition estimates."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "MettleUp uses the microphone so you can talk to your AI coach.",
          "speechRecognitionPermission": "MettleUp uses speech recognition so you can log workouts and meals by voice."
        }
      ],
      "expo-sqlite",
      [
        "expo-secure-store",
        {
          "configureAndroidBackup": false
        }
      ],
      "./plugins/backup-rules/withBackupRules.js",
      "@react-native-google-signin/google-signin",
      "expo-sharing",
      "expo-audio",
      [
        "expo-notifications",
        {
          "icon": "./assets/images/notification-icon.png",
          "color": "#F0662A"
        }
      ],
      "expo-video"
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    },
    "extra": {
      "router": {},
      "supabaseUrl": "https://hdxzqbdiokjklnypfisq.supabase.co",
      "supabaseProxyUrl": "https://app.mettleup.fit/sb",
      "supabaseProxyFallbackUrls": ["https://forgeai.aakashpahuja.in/sb"],
      "supabasePublishableKey": "sb_publishable_-GBJ1u036bdCX2mtff3ghQ_Gx-hZyGo",
      "googleWebClientId": "301992813103-a5m1pqvut8oobo5b6lpljn7al3o4u2be.apps.googleusercontent.com",
      "distribution": "github"
    },
    "owner": "aucksy"
  }
}
