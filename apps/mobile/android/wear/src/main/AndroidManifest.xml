<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

  <!-- R-167: Play lists this build for watches only (it is the Wear OS half of com.mettleup.app). -->
  <uses-feature
    android:name="android.hardware.type.watch"
    android:required="true" />

  <!-- The end-of-rest buzz (Vibrator, alarm usage) and the brief wake while it runs. -->
  <uses-permission android:name="android.permission.VIBRATE" />
  <uses-permission android:name="android.permission.WAKE_LOCK" />
  <!-- A rest still running after a restart gets its alarm and countdown back (BootReceiver). -->
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- "Rest is over" and the resting countdown (Ongoing Activity); asked on first open (Wear OS 4+). -->
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- Live heart rate (Health Services MeasureClient). Wear OS 6 / Android 16 names it
       health.READ_HEART_RATE; earlier versions use BODY_SENSORS. Both are asked for. -->
  <uses-permission android:name="android.permission.BODY_SENSORS" />
  <uses-permission android:name="android.permission.health.READ_HEART_RATE" />
  <!-- The rest's end alarm. R-167 (28 Oct 2026, the watch app goes to Google Play): NO
       USE_EXACT_ALARM, as the phone since 0.56.1. Play allows it only for alarm-clock and calendar
       apps. SCHEDULE_EXACT_ALARM is the watch's "Alarms & reminders" switch (off by default on a new
       install from Wear OS 5): the app shows "Allow alarms" until it is on; meanwhile the end alarm
       is inexact (RestAlerts.arm) and the open screen buzzes on time itself (MainActivity). -->
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM" />

  <application
    android:allowBackup="false"
    android:icon="@drawable/ic_launcher"
    android:label="@string/app_name"
    android:supportsRtl="true"
    android:theme="@android:style/Theme.DeviceDefault">

    <!-- Needs the phone app: everything it shows comes from MettleUp on the phone (false = Play
         offers it to watches paired with a phone that has MettleUp). -->
    <meta-data
      android:name="com.google.android.wearable.standalone"
      android:value="false" />

    <!-- R-166: ambient mode (AmbientLifecycleObserver) uses the watch's wearable library when
         present; not required, so a watch without it still installs the app. -->
    <uses-library
      android:name="com.google.android.wearable"
      android:required="false" />

    <activity
      android:name=".MainActivity"
      android:exported="true"
      android:launchMode="singleTask"
      android:taskAffinity=""
      android:theme="@android:style/Theme.DeviceDefault">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>

    <!-- The phone's rest and workout state (Data Layer items /forge/rest and /forge/workout), and
         its answer to a set it could not log. -->
    <service
      android:name=".ForgeListenerService"
      android:exported="true">
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.DATA_CHANGED" />
        <data
          android:host="*"
          android:pathPrefix="/forge"
          android:scheme="wear" />
      </intent-filter>
      <!-- U-W3: the phone's "could not log that set" answer (/forge/nack/done). -->
      <intent-filter>
        <action android:name="com.google.android.gms.wearable.MESSAGE_RECEIVED" />
        <data
          android:host="*"
          android:pathPrefix="/forge/nack"
          android:scheme="wear" />
      </intent-filter>
    </service>

    <!-- Restart / app update: a running rest's alarm and countdown come back. -->
    <receiver
      android:name=".BootReceiver"
      android:exported="true">
      <intent-filter>
        <action android:name="android.intent.action.BOOT_COMPLETED" />
        <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
        <!-- R-167: "Alarms & reminders" was just allowed: a running rest's alarm is set again, exact. -->
        <action android:name="android.app.action.SCHEDULE_EXACT_ALARM_PERMISSION_STATE_CHANGED" />
      </intent-filter>
    </receiver>

    <!-- The rest's end: buzz + "Rest is over". -->
    <receiver
      android:name=".RestAlarmReceiver"
      android:exported="false" />

    <!-- C5-2: Done / +15 s / Skip / Complete set on this app's own cards, sent to the phone. -->
    <receiver
      android:name=".WatchActionReceiver"
      android:exported="false" />
  </application>
</manifest>
