<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <!-- v0.27.0: Health Connect's client library asks for Android 8; the app checks for Android 9+ before using it. -->
  <uses-sdk tools:overrideLibrary="androidx.health.connect.client"/>
  <uses-permission android:name="android.permission.INTERNET"/>
  <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <!-- Launch plan C5 (20 Oct 2026): the microphone was only for the AI coach, which is off (features.ts).
       tools:node="remove" also drops it from libraries' merged manifests (expo-speech-recognition). -->
  <uses-permission android:name="android.permission.RECORD_AUDIO" tools:node="remove"/>
  <uses-permission android:name="android.permission.SYSTEM_ALERT_WINDOW"/>
  <uses-permission android:name="android.permission.VIBRATE"/>
  <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
  <!-- 0.56.1 (Google Play policy): Play allows USE_EXACT_ALARM only for alarm-clock and calendar
       apps. tools:node="remove" keeps it out of the merged manifest even if a library adds it; the
       rest timer asks for "Alarms & reminders" (SCHEDULE_EXACT_ALARM) instead. -->
  <uses-permission android:name="android.permission.USE_EXACT_ALARM" tools:node="remove"/>
  <!-- 0.58.1 (R-153): expo-background-task runs the gym-notice check as plain WorkManager periodic work.
       WorkManager's library manifest adds FOREGROUND_SERVICE for setForeground(), which nothing here calls
       (no ongoing foreground notification), so it stays out of the merged manifest and the approved list. -->
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" tools:node="remove"/>
  <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE" android:maxSdkVersion="32" tools:replace="android:maxSdkVersion"/>
  <queries>
    <intent>
      <action android:name="android.intent.action.VIEW"/>
      <category android:name="android.intent.category.BROWSABLE"/>
      <data android:scheme="https"/>
    </intent>
  </queries>
  <!-- Release A (A3): the Gym tab's "Check in" / "Scan the poster" opens the phone's own camera to
       read the gym's QR poster (src/shop/scanPoster.ts). Android 11+ only lets the app see a camera
       app it lists here. -->
  <queries>
    <intent>
      <action android:name="android.media.action.STILL_IMAGE_CAMERA"/>
    </intent>
  </queries>
  <queries>
    <package android:name="com.google.android.googlequicksearchbox"/>
    <intent>
      <action android:name="android.speech.RecognitionService"/>
    </intent>
  </queries>
  <application android:name=".MainApplication" android:label="@string/app_name" android:icon="@mipmap/ic_launcher" android:roundIcon="@mipmap/ic_launcher_round" android:allowBackup="true" android:theme="@style/AppTheme" android:supportsRtl="true" android:enableOnBackInvokedCallback="false" android:fullBackupContent="@xml/forgeai_backup_rules" android:dataExtractionRules="@xml/forgeai_data_extraction_rules" android:gwpAsanMode="never">
    <meta-data android:name="expo.modules.notifications.default_notification_icon" android:resource="@drawable/notification_icon"/>
    <meta-data android:name="expo.modules.notifications.default_notification_color" android:resource="@color/notification_icon_color"/>
    <meta-data android:name="expo.modules.updates.ENABLED" android:value="false"/>
    <meta-data android:name="expo.modules.updates.ENABLE_BSDIFF_PATCH_SUPPORT" android:value="true"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_CHECK_ON_LAUNCH" android:value="ALWAYS"/>
    <meta-data android:name="expo.modules.updates.EXPO_UPDATES_LAUNCH_WAIT_MS" android:value="0"/>
    <activity android:name=".MainActivity" android:configChanges="keyboard|keyboardHidden|orientation|screenSize|screenLayout|uiMode|smallestScreenSize" android:launchMode="singleTask" android:windowSoftInputMode="adjustResize" android:theme="@style/Theme.App.SplashScreen" android:exported="true" android:screenOrientation="portrait">
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
      <intent-filter>
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="mettleup"/>
        <!-- MettleUp (R-105): the old scheme keeps working, so old links and widgets still open the app. -->
        <data android:scheme="forgeai"/>
      </intent-filter>
      <!-- MettleUp (R-105): the new address of gym links and check-in posters. Verified against
           https://app.mettleup.fit/.well-known/assetlinks.json (must list com.mettleup.app). -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="app.mettleup.fit" android:pathPrefix="/j/"/>
      </intent-filter>
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="app.mettleup.fit" android:pathPrefix="/c/"/>
      </intent-filter>
      <!-- v0.38.0 invite link: a gym's link (WhatsApp, front-desk QR) opens the app on "Join <gym>".
           The old address, kept for good (printed posters, old messages). Verified against
           https://forgeai.aakashpahuja.in/.well-known/assetlinks.json (must list com.mettleup.app too). -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="forgeai.aakashpahuja.in" android:pathPrefix="/j/"/>
      </intent-filter>
      <!-- QR self check-in: the gym's check-in poster (/c/<CODE>) opens the app on "Check in at <gym>".
           Same host and the same assetlinks.json as the invite link. -->
      <intent-filter android:autoVerify="true">
        <action android:name="android.intent.action.VIEW"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <category android:name="android.intent.category.BROWSABLE"/>
        <data android:scheme="https" android:host="forgeai.aakashpahuja.in" android:pathPrefix="/c/"/>
      </intent-filter>
      <!-- Health Connect (Android 13 and older): "why MettleUp asks" opens the app. -->
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
      </intent-filter>
      <!-- v0.28.0: a Hevy / Strong export shared from the share menu opens the import. -->
      <intent-filter>
        <action android:name="android.intent.action.SEND"/>
        <category android:name="android.intent.category.DEFAULT"/>
        <data android:mimeType="text/csv"/>
        <data android:mimeType="text/comma-separated-values"/>
        <data android:mimeType="application/csv"/>
        <data android:mimeType="application/vnd.ms-excel"/>
        <data android:mimeType="application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"/>
      </intent-filter>
    </activity>
    <!-- Health Connect (Android 14+): the same, from the system's permission screens. -->
    <activity-alias android:name="ViewPermissionUsageActivity" android:exported="true" android:targetActivity=".MainActivity" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
        <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
      </intent-filter>
    </activity-alias>
  </application>
</manifest>