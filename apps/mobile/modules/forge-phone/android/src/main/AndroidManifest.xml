<manifest xmlns:android="http://schemas.android.com/apk/res/android" xmlns:tools="http://schemas.android.com/tools">
  <uses-sdk tools:overrideLibrary="androidx.health.connect.client"/>
  <!-- Health Connect: write each finished workout and its calories. -->
  <uses-permission android:name="android.permission.health.WRITE_EXERCISE"/>
  <uses-permission android:name="android.permission.health.WRITE_ACTIVE_CALORIES_BURNED"/>
  <!-- F55 / F62 (1 Nov 2026): read weigh-ins into the body-weight log, and today's step count.
       Each is asked only when the member says yes on the Health Connect page. -->
  <uses-permission android:name="android.permission.health.READ_WEIGHT"/>
  <uses-permission android:name="android.permission.health.READ_STEPS"/>
  <queries>
    <package android:name="com.google.android.apps.healthdata"/>
  </queries>
  <application>
    <!-- R-267: Health Connect's "privacy policy" link (Android 13 and older) shows MettleUp's privacy
         notice, as Google requires (it used to open the app's home screen). -->
    <activity android:name="com.forgeai.phone.HealthRationaleActivity" android:exported="true" android:excludeFromRecents="true" android:noHistory="true" android:theme="@android:style/Theme.Translucent.NoTitleBar">
      <intent-filter>
        <action android:name="androidx.health.ACTION_SHOW_PERMISSIONS_RATIONALE"/>
      </intent-filter>
    </activity>
    <!-- R-267: the same from Android 14+'s permission screens. Declared right after its target
         (an alias must follow the activity it points to in the merged manifest). -->
    <activity-alias android:name="com.forgeai.phone.ViewPermissionUsageActivity" android:exported="true" android:targetActivity="com.forgeai.phone.HealthRationaleActivity" android:permission="android.permission.START_VIEW_PERMISSION_USAGE">
      <intent-filter>
        <action android:name="android.intent.action.VIEW_PERMISSION_USAGE"/>
        <category android:name="android.intent.category.HEALTH_PERMISSIONS"/>
      </intent-filter>
    </activity-alias>
    <!-- Home-screen widgets: today's workout, this week, and (R-320) how busy the gym is. -->
    <receiver android:name="com.forgeai.phone.TodayWidget" android:exported="true" android:label="@string/forge_widget_today_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <!-- Redraw both widgets when the clock or time zone is changed (Android still delivers
           these two to a manifest receiver). The after-midnight redraw is an explicit alarm. -->
      <intent-filter>
        <action android:name="android.intent.action.TIME_SET"/>
        <action android:name="android.intent.action.TIMEZONE_CHANGED"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/forge_widget_today"/>
    </receiver>
    <receiver android:name="com.forgeai.phone.WeekWidget" android:exported="true" android:label="@string/forge_widget_week_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/forge_widget_week"/>
    </receiver>
    <!-- R-320: "Gym right now": how busy the member's gym is; tap to check in. -->
    <receiver android:name="com.forgeai.phone.GymWidget" android:exported="true" android:label="@string/forge_widget_gym_label">
      <intent-filter>
        <action android:name="android.appwidget.action.APPWIDGET_UPDATE"/>
      </intent-filter>
      <meta-data android:name="android.appwidget.provider" android:resource="@xml/forge_widget_gym"/>
    </receiver>
  </application>
</manifest>
