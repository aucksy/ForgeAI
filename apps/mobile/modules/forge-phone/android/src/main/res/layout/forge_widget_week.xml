<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forge_week_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forge_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
  <TextView
      android:id="@+id/forge_week_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="THIS WEEK"
      android:textColor="#FF7A3B"
      android:textSize="11sp"
      android:textStyle="bold"
      android:letterSpacing="0.08"/>
  <TextView
      android:id="@+id/forge_week_count"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:maxLines="1"
      android:text="ForgeAI"
      android:textColor="#F2F3F5"
      android:textSize="18sp"
      android:textStyle="bold"/>
  <TextView
      android:id="@+id/forge_week_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Open ForgeAI to update"
      android:textColor="#A0A4AE"
      android:textSize="13sp"/>
  <LinearLayout
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="10dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/forge_week_d0"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="M"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/forge_week_d1"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="T"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/forge_week_d2"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="W"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/forge_week_d3"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="T"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/forge_week_d4"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="F"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/forge_week_d5"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="4dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="S"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
    <TextView
        android:id="@+id/forge_week_d6"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:layout_marginEnd="0dp"
        android:background="@drawable/forge_day_open"
        android:gravity="center"
        android:text="S"
        android:textColor="#A0A4AE"
        android:textSize="10sp"
        android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
