<!-- R-320: "Gym right now": how busy the member's gym is, when it was read, and Check in. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forge_gym_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forge_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
  <TextView
      android:id="@+id/forge_gym_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="GYM RIGHT NOW"
      android:textColor="#FF7A3B"
      android:textSize="11sp"
      android:textStyle="bold"
      android:letterSpacing="0.08"/>
  <TextView
      android:id="@+id/forge_gym_name"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="MettleUp"
      android:textColor="#A0A4AE"
      android:textSize="12sp"/>
  <TextView
      android:id="@+id/forge_gym_word"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="1"
      android:text="Open MettleUp"
      android:textColor="#F2F3F5"
      android:textSize="22sp"
      android:textStyle="bold"/>
  <TextView
      android:id="@+id/forge_gym_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="Open the app once to see how busy your gym is"
      android:textColor="#A0A4AE"
      android:textSize="13sp"/>
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/forge_gym_time"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:ellipsize="end"
        android:maxLines="1"
        android:text=""
        android:textColor="#A0A4AE"
        android:textSize="12sp"/>
    <TextView
        android:id="@+id/forge_gym_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open"
        android:textColor="#FF7A3B"
        android:textSize="13sp"
        android:textStyle="bold"/>
  </LinearLayout>
</LinearLayout>
