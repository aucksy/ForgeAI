<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forge_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forge_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
  <!-- R-320: TODAY and the action (Start / Resume / Open) share the top row, so the what-to-beat
       lines below never push the action off a small widget (a tall widget only cuts the last line). -->
  <LinearLayout
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:orientation="horizontal">
    <TextView
        android:id="@+id/forge_today_label"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:text="TODAY"
        android:textColor="#FF7A3B"
        android:textSize="11sp"
        android:textStyle="bold"
        android:letterSpacing="0.08"/>
    <TextView
        android:id="@+id/forge_today_action"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Open"
        android:textColor="#FF7A3B"
        android:textSize="13sp"
        android:textStyle="bold"/>
  </LinearLayout>
  <TextView
      android:id="@+id/forge_today_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="MettleUp"
      android:textColor="#F2F3F5"
      android:textSize="18sp"
      android:textStyle="bold"/>
  <TextView
      android:id="@+id/forge_today_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="Open MettleUp to see your workout"
      android:textColor="#A0A4AE"
      android:textSize="13sp"/>
  <!-- R-320: what to beat on the first lifts (gone when the app wrote none). -->
  <TextView
      android:id="@+id/forge_today_beat1"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="6dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="#F2F3F5"
      android:textSize="12sp"
      android:visibility="gone"/>
  <TextView
      android:id="@+id/forge_today_beat2"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:textColor="#F2F3F5"
      android:textSize="12sp"
      android:visibility="gone"/>
</LinearLayout>
