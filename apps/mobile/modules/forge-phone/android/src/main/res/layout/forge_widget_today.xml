<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/forge_today_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/forge_widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
  <TextView
      android:id="@+id/forge_today_label"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:text="TODAY"
      android:textColor="#FF7A3B"
      android:textSize="11sp"
      android:textStyle="bold"
      android:letterSpacing="0.08"/>
  <TextView
      android:id="@+id/forge_today_title"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="4dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="ForgeAI"
      android:textColor="#F2F3F5"
      android:textSize="18sp"
      android:textStyle="bold"/>
  <TextView
      android:id="@+id/forge_today_line"
      android:layout_width="match_parent"
      android:layout_height="wrap_content"
      android:layout_marginTop="2dp"
      android:ellipsize="end"
      android:maxLines="2"
      android:text="Open ForgeAI to see your workout"
      android:textColor="#A0A4AE"
      android:textSize="13sp"/>
  <TextView
      android:id="@+id/forge_today_action"
      android:layout_width="wrap_content"
      android:layout_height="wrap_content"
      android:layout_marginTop="8dp"
      android:text="Open"
      android:textColor="#FF7A3B"
      android:textSize="13sp"
      android:textStyle="bold"/>
</LinearLayout>
