<?xml version="1.0" encoding="utf-8"?>
<!--
  R-55 (22 Oct 2026): the live workout card's own view, inside Android's decorated notification frame
  (WorkoutCard.kt). Line 1: the exercise, and on the right the workout time counting up ("42:15";
  standing still while paused). Line 2: the next set ("Set 3 of 5 · 35 kg × 11"). The exercise's
  picture sits on the left when there is one. The time lives HERE, not in the card's header: a header
  chronometer needs `when` = the workout's start, and Android then ranks the card as old, below any
  newer notification on the lock screen (review, 22 Oct). Every line is ONE line, without font padding,
  so the collapsed card stays within about 48 dp with large text (as forge_rest_card.xml).
  Looked up by name in WorkoutCard.kt; kept by forge_rest_keep.xml.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:id="@+id/forge_live_pic"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:layout_marginEnd="12dp"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:importantForAccessibility="no" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/forge_live_title"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />

            <Chronometer
                android:id="@+id/forge_live_time"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:singleLine="true"
                android:includeFontPadding="false"
                android:textAppearance="@android:style/TextAppearance.Material.Notification.Title" />
        </LinearLayout>

        <TextView
            android:id="@+id/forge_live_text"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:singleLine="true"
            android:includeFontPadding="false"
            android:textAppearance="@android:style/TextAppearance.Material.Notification" />
    </LinearLayout>
</LinearLayout>
