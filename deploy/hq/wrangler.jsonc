// MettleUp HQ (#51): the system owner's panel, https://hq.mettleup.fit (R-105, 24 Oct 2026; the old
// https://forgeai-hq.aakashpahuja.in keeps working too, each with its own sign-in). NOT DEPLOYED: the
// main session deploys after review. From this folder: npx wrangler deploy
// The page is plain static files (apps/hq/public, no build step); worker.js runs FIRST for every
// path, so nothing is served before the sign-in check. Plan: docs/overhaul/research/R-owner-panel.md.
//
// Secrets (never in this file; `npx wrangler secret put <NAME>` from this folder):
//   SUPABASE_HQ_KEY       a Supabase secret key named "hq" (Supabase dashboard -> Project Settings ->
//                         API Keys -> Secret keys -> New secret key). Only the hq_* functions take it.
//   HQ_ALLOWED_EMAIL      the one Google address allowed in (a comma list is accepted).
//   HQ_SESSION_SECRET     64 random characters (signs the session cookie). Google mode only.
//   GOOGLE_CLIENT_ID      from Google Cloud -> APIs & Services -> Credentials -> OAuth client
//   GOOGLE_CLIENT_SECRET    (Web application; redirect URIs https://hq.mettleup.fit/auth/callback and
//                         https://forgeai-hq.aakashpahuja.in/auth/callback: one per address).
//   GITHUB_TOKEN          optional: only raises GitHub's hourly limit for the download counts.
//   FCM_SERVICE_ACCOUNT   the gym's messages and offers popping up on phones (push.js): a JSON key of a
//                         service account in Firebase project forgeai-d7eea with the role "Firebase
//                         Cloud Messaging API Admin". Not set: no pop-ups are sent, nothing else changes.
// Variables below: AUTH_MODE "google" (no cost) or "access" (Cloudflare Access in front; then set
// ACCESS_TEAM = the team name in <team>.cloudflareaccess.com and ACCESS_AUD = the application's
// audience tag, and the Google secrets are not needed).
{
  "name": "forgeai-hq",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  "assets": {
    "directory": "../../apps/hq/public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "routes": [
    { "pattern": "hq.mettleup.fit", "custom_domain": true },
    { "pattern": "forgeai-hq.aakashpahuja.in", "custom_domain": true }
  ],
  "workers_dev": false,
  "preview_urls": false,
  "vars": {
    "SUPABASE_URL": "https://hdxzqbdiokjklnypfisq.supabase.co",
    "AUTH_MODE": "google",
    "ACCESS_TEAM": "",
    "ACCESS_AUD": "",
    "HQ_GITHUB_REPO": "aucksy/ForgeAI"
  },
  // The same small Cloudflare database as the gym panel: feedback, leads, AI usage and AI limits
  // (tables: deploy/panel/migrations). HQ reads them and changes statuses and limits.
  "d1_databases": [
    { "binding": "WEB", "database_name": "forgeai-web", "database_id": "2c036974-ccdc-4a3c-adf8-47a2e243839d", "migrations_dir": "../panel/migrations" }
  ],
  // The nightly clean-up, 03:00 India time (21:30 UTC): access log and old logs (hq_nightly_cleanup)
  // and Cloudflare's database (old feedback, leads without a deal, AI usage).
  // Every minute: the gym's messages and offers that are due go to members' phones (push.js, R-153 step 2).
  // Needs the secret FCM_SERVICE_ACCOUNT (a Firebase service-account JSON key, role "Firebase Cloud
  // Messaging API Admin") and migration 0038; without either it stops at once and sends nothing.
  // Optional var PUSH_SUBREQUESTS (default 45, for the free plan's 50 calls per run).
  "triggers": { "crons": ["30 21 * * *", "* * * * *"] },
  // The nightly backup (backup.js, launch audit 3 Nov 2026) runs in the 21:30 trigger above, before the clean-up.
  // Its store: free KV namespace forgeai-backups (made 4 Nov 2026 with the owner's yes). Docs: docs/BACKUP-RESTORE.md.
  "kv_namespaces": [{ "binding": "BACKUP", "id": "998066b50d4f403b99883b30f83f06cb" }],
  // Billing step 3 (billing.js): a gym owner buys a MettleUp plan online; the payment company's webhook is
  // https://hq.mettleup.fit/billing/hook/razorpay (or /cashfree). OFF: var BILLING is not set. To switch on in
  // TEST mode: vars BILLING "test" and BILLING_PROVIDER "razorpay" | "cashfree", and the secrets
  // RAZORPAY_KEY_ID (rzp_test_...), RAZORPAY_KEY_SECRET, RAZORPAY_WEBHOOK_SECRET, or CASHFREE_APP_ID and
  // CASHFREE_SECRET_KEY (sandbox); plus supabase 0063 applied and app_config 'billing_checkout' on.
  "observability": { "enabled": true }
}
