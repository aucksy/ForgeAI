// MettleUp's web side on Cloudflare (R-105, 24 Oct 2026): one Worker with the admin app's static
// files (apps/dashboard/dist) answers every address. Build first (apps/dashboard: npm run build),
// then from this folder: npx wrangler deploy
//   https://mettleup.fit            the landing page (www.mettleup.fit, mettleup.in, www.mettleup.in
//                                   send people there, same path)
//   https://app.mettleup.fit        the admin app, /sb, /j, /c, /api, /start, legal pages
//   https://forgeai.aakashpahuja.in the old address, kept for good (old phones, printed posters)
// Which host shows what: hosts.js. worker.js runs first for every path except the hashed /assets/
// files (so each host can redirect); everything it does not handle is the static panel, as before.
{
  "name": "forgeai-panel",
  "compatibility_date": "2026-10-01",
  "main": "worker.js",
  // No second public copy of the admin app (and its /sb) on workers.dev or preview URLs.
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "../../apps/dashboard/dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/*", "!/assets/*"]
  },
  "routes": [
    { "pattern": "forgeai.aakashpahuja.in", "custom_domain": true },
    { "pattern": "app.mettleup.fit", "custom_domain": true },
    { "pattern": "mettleup.fit", "custom_domain": true },
    { "pattern": "www.mettleup.fit", "custom_domain": true },
    { "pattern": "mettleup.in", "custom_domain": true },
    { "pattern": "www.mettleup.in", "custom_domain": true }
  ],
  // Launch H7 (21 Oct 2026): "Send feedback" from both apps (feedback.js). Cloudflare's free
  // database, not the gym server. Tables: migrations/ (npx wrangler d1 migrations apply forgeai-web --remote).
  // Launch I2: the landing page (/home/) stayed hidden (404) until the owner said yes: "live" since
  // 22 Oct 2026 (Project Tracker #40, A). "off" hides it again (and its lead form) on the next deploy.
  // #47 AI import (aiMatch.js): secrets, never in this file: GEMINI_API_KEY (Google AI, tried first)
  // and ANTHROPIC_API_KEY (Claude, the fallback); either, both or none (none = owners match by hand).
  // `npx wrangler secret put GEMINI_API_KEY`. Optional var GEMINI_MODEL swaps the Gemini model.
  // Needs table ai_usage (migrations/0003_ai_usage.sql).
  // MOVE (R-105): "on" sends /home on the old address to mettleup.fit, and lets the old address's
  // admin app move each desk to app.mettleup.fit once nothing is waiting to be sent. "off" keeps
  // the old address exactly as it was (a kill switch; deploy again to apply).
  // R-157 (28 Oct 2026): keep the Worker's log lines (Workers Logs, free allowance) so a failed AI
  // match can be read afterwards; before this only a live `wrangler tail` showed them.
  "observability": { "enabled": true },
  // #72 (30 Oct 2026): 21:30 UTC = 03:00 India, every day: delete crash reports older than 90 days (worker.js scheduled).
  // R-206: spoken feedback (voice.js) needs the secret GROQ_API_KEY; optional var GROQ_MODEL swaps the Whisper model.
  "triggers": { "crons": ["30 21 * * *"] },
  "vars": { "LANDING": "live", "MOVE": "on" },
  // R-153 step 2: after the admin app sends a message or starts an offer, the proxy tells the HQ Worker
  // (deploy/hq/push.js) to send the phone pop-ups at once (proxy.js pushAfter). Without it they go
  // within a minute anyway (HQ's own Cron Trigger).
  "services": [{ "binding": "HQ_PUSH", "service": "forgeai-hq" }],
  "d1_databases": [
    { "binding": "WEB", "database_name": "forgeai-web", "database_id": "2c036974-ccdc-4a3c-adf8-47a2e243839d", "migrations_dir": "migrations" }
  ]
}
