# Repo-root ignores. Each app/package has its own .gitignore for tool-specific paths.

# dependencies (workspaces hoist here)
node_modules/

# secrets / keys
*.pem
*.jks
*.p8
*.p12
*.key
*.mobileprovision

# local env
.env
.env*.local

# typescript / tooling
*.tsbuildinfo

# debug logs
npm-debug.*
yarn-debug.*
yarn-error.*

# macOS
.DS_Store

__pycache__/
scripts/realtime-test/realtime-test-log.txt

# wrangler dev / local D1 (deploy/panel)
deploy/panel/.wrangler/

# impeccable design-run scratch (review screenshots, decision pages)
apps/dashboard/.impeccable/review/
apps/dashboard/.impeccable/questions/
apps/dashboard/.impeccable/mocks/
apps/dashboard/.impeccable/build/
